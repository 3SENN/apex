{
  "about": "Apex-written classifier corpus. Each case lists the attributes a frame reads off one field and the kind Apex should give it; unlisted attributes are empty.",
  "cases": [
    { "note": "autocomplete wins over a misleading name", "a": { "autocomplete": "email", "name": "username" }, "kind": "email" },
    { "note": "section- prefix and shipping/billing modifiers", "a": { "autocomplete": "section-checkout shipping postal-code" }, "kind": "postal-code" },
    { "a": { "autocomplete": "billing cc-number" }, "kind": "cc-number" },
    { "a": { "autocomplete": "section-a billing address-line1" }, "kind": "address-line1" },
    { "a": { "autocomplete": "one-time-code", "inputMode": "numeric" }, "kind": "otp" },
    { "a": { "autocomplete": "current-password", "type": "password" }, "kind": "current-password" },
    { "a": { "autocomplete": "new-password", "type": "password" }, "kind": "new-password" },
    { "note": "a birthday token stops the card guess", "a": { "autocomplete": "bday-month", "label": "Expiry month" }, "kind": null },
    { "note": "autocomplete=off never hides a password", "a": { "autocomplete": "off", "type": "password", "name": "pass" }, "kind": "current-password" },
    { "a": { "type": "password", "label": "Confirm password" }, "kind": "new-password" },
    { "a": { "type": "password", "label": "Choose a password" }, "kind": "new-password" },
    { "a": { "type": "password", "label": "CVC", "maxLength": 4 }, "kind": "cc-csc" },
