{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "composite": true,
    "noEmit": true,
    "types": [],
    "paths": {
      "@shared/*": ["./src/shared/*"],
      // The private internal/ folder when it is there, else the public stubs (scripts/internal.mjs).
      "@internal/*": ["./internal/*", "./src/stubs/*"]
    }
  },
  "include": ["src/renderer/src/**/*", "src/renderer/preprocess/**/*", "src/shared/**/*", "src/kit/**/*", "src/stubs/**/*", "internal/engines/**/*"],
  // Main-process parts of the stubs and the internal folder (tsconfig.node.json checks those).
  "exclude": ["src/stubs/*/main.ts", "internal/*/main.ts", "internal/*/*/main/**/*"]
}
