{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "composite": true,
    "noEmit": true,
    "types": [],
    "paths": {
      "@shared/*": ["./src/shared/*"],
      // The engines besides the API key (src/engines).
      "@engines/*": ["./src/engines/*"]
    }
  },
  "include": ["src/renderer/src/**/*", "src/renderer/preprocess/**/*", "src/shared/**/*", "src/kit/**/*", "src/engines/**/*"],
  // The engines' main-process parts (tsconfig.node.json checks those).
  "exclude": ["src/engines/main.ts", "src/engines/*/main/**/*"]
}
