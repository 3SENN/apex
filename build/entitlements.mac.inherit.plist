<!--
  Entitlements for everything nested in Atelier.app: the Electron helpers,
  atelier-speech, the calendar helper and the haptics addon.
  - allow-jit: the renderer and utility helpers run V8.
  - audio-input, camera: Chromium captures in its audio and video services,
    and atelier-speech listens for dictation and meetings.
  - calendars: the read-only Calendar and Reminders helper.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
</dict>
</plist>
