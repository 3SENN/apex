<!--
  Apex's hardened-runtime entitlements, for the app itself.
  - allow-jit: V8, and the meshopt decoder the companion compiles as wasm.
  - audio-input, camera: dictation, meetings, and calls on sites you allow.
  - location: sites you allow to see your approximate location.
  - calendars: the calendar helper (native/calendar) asks in Apex's name, and macOS checks
    the responsible app, so Apex carries it too. Read-only, and only after you
    turn calendars or reminders on.
  Without these the hardened runtime refuses the request before macOS asks.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.personal-information.location</key>
	<true/>
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
</dict>
</plist>
