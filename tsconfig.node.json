{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "composite": true,
    "noEmit": true,
    "paths": {
      "@shared/*": ["./src/shared/*"],
      // The private internal/ folder when it is there, else the public stubs (scripts/internal.mjs).
      "@internal/*": ["./internal/*", "./src/stubs/*"]
    }
  },
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "src/renderer/src/agentLog.ts",
    "src/renderer/src/packs/logic.ts",
    "src/renderer/src/meetings/logic.ts",
    "src/renderer/src/companion/animator.ts",
    "src/renderer/src/companion/locomotion.ts",
    "src/renderer/src/companion/layout.ts",
    "src/renderer/src/companion/presenceCore.ts",
    "src/renderer/src/companion/liveBudget.ts",
    "src/renderer/src/companion/cadence.ts",
    "src/renderer/src/components/newtab/floorSim.ts",
    "src/renderer/src/components/newtab/newtabLogic.ts",
    "src/renderer/src/components/newtab/searchLogic.ts",
    "src/renderer/src/components/newtab/handoff.ts",
    "src/renderer/src/float/launcher/presenceRelay.ts",
    "src/renderer/src/pages/welcomeLogic.ts",
    "src/renderer/src/pages/welcome/stage.ts",
    "src/renderer/src/ui/logic/**/*",
    "src/renderer/src/companion-card/logic/**/*",
    "src/renderer/src/chat/logic/**/*",
    "src/renderer/src/chat/dictation/logic.ts",
    "src/renderer/src/chat/attachments/waiting.ts",
    "src/renderer/src/chat/attachments/drafts.ts",
    "src/renderer/src/settings/logic/**/*",
    "src/renderer/src/speech/logic.ts",
    "src/renderer/src/speech/errorCopy.ts",
    "src/renderer/src/components/sidebar/logic/**/*",
    "src/renderer/src/components/address.ts",
    "src/renderer/src/components/toolbarLogic.ts",
    "src/renderer/src/components/startSurfaceLogic.ts",
    "src/renderer/src/files/libraryCompanions.ts",
    "src/renderer/src/overlay/surfaces/chat/logic.ts",
    "src/renderer/src/overlay/surfaces/address/enter.ts",
    "src/renderer/src/overlay/host/viewport.ts",
    "src/renderer/src/overlay/surfaces/sites/logic.ts",
    "src/renderer/src/overlay/surfaces/sites/promptLogic.ts",
    "src/renderer/src/overlay/surfaces/workspace/spaceChoice.ts",
    "src/renderer/src/pages/errors/logic.ts",
    "src/renderer/src/settings/sections/network/logic.ts",
    "src/renderer/src/overlay/kit/logic.ts",
    "src/renderer/src/overlay/surfaces/menus/task-manager/taskLogic.ts",
    "src/renderer/src/updates/logic/**/*",
    "src/renderer/src/diagnostics/logic/**/*",
    "src/renderer/src/connectors/logic/**/*",
    "src/renderer/src/activity/logic.ts",
    "src/renderer/src/reader/logic/**/*",
    "src/renderer/src/brand/wordmark.ts",
    "tests/**/*",
    "src/stubs/**/*",
    // The internal folder's main-process, shared and test code (its renderer parts are tsconfig.web.json's).
    "internal/**/*.ts",
    "electron.vite.config.ts",
    "vitest.config.ts"
  ],
  // The renderer's seam to the engines (tsconfig.web.json checks it).
  "exclude": ["src/stubs/*/renderer.ts"]
}
